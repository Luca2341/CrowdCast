<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Go Live</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>

<body style="background:#0b0f1a;color:white;font-family:Arial;">

<h2>🎥 Go Live</h2>

<video id="video" autoplay muted style="width:300px"></video>
<br><br>

<input id="title" placeholder="Stream Titel">
<button onclick="start()">Start Stream</button>

<script>

const supabaseUrl = "DEINE_URL";
const supabaseKey = "DEIN_KEY";
const supabase = supabase.createClient(supabaseUrl, supabaseKey);

let stream;
let pc;

async function start(){

  const title=document.getElementById("title").value;

  stream = await navigator.mediaDevices.getUserMedia({
    video:true,audio:true
  });

  document.getElementById("video").srcObject=stream;

  await supabase.from("streams").insert([{
    title:title,
    is_live:true
  }]);

  pc = new RTCPeerConnection();

  stream.getTracks().forEach(t=>pc.addTrack(t,stream));

  const offer=await pc.createOffer();
  await pc.setLocalDescription(offer);

  alert("Stream gestartet (MVP)");

}

</script>

</body>
</html>
